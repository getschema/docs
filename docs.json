{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "almond",
  "name": "Schema",
  "colors": {
    "primary": "#ffffff",
    "light": "#ffffff",
    "dark": "#000000"
  },
  "favicon": {
    "light": "/images/schema-avatar-wink.png",
    "dark": "/images/schema-avatar-wink.png"
  },
  "navigation": {
    "pages": [
      {
        "group": "Getting Started",
        "pages": [
          "index",
          "quickstart"
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Documentation",
          "href": "https://docs.getschema.app",
          "icon": "book-open-cover"
        }
      ]
    }
  },
  "logo": {
    "light": "/images/schema-avatar-smile.png",
    "dark": "/images/schema-avatar-wink.png",
    "href": "https://getschema.app"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@getschema.app"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://getschema.app/platform"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "instagram": "https://x.com/getschema"
    }
  },
  "description": "Turn the World into a function.",
  "fonts": {
    "family": "DM Sans"
  }
}
